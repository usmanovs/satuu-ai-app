# ---- Browser (safe to expose: public project URL + publishable/anon key) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Optional: run with fictional fixtures, no Supabase, no sending. Never set in production.
# VITE_DEMO_MODE=true

# ---- Server-side only: set as Supabase Edge Function secrets, NEVER in a VITE_ variable ----
# supabase secrets set --env-file supabase/.env.functions
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions automatically.)
#
# n8n webhook that sends a human reply through the existing WhatsApp credential:
# N8N_SEND_WEBHOOK_URL=https://YOUR-N8N-HOST/webhook/REPLACE_WITH_UNGUESSABLE_PATH
# N8N_SEND_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
# Approved WhatsApp template used outside the 24h window (leave unset = "Не подключено"):
# WA_TEMPLATE_NAME=your_approved_template_name
# WA_TEMPLATE_LANG=ru
# Optional CORS lock for the dashboard origin:
# ALLOWED_ORIGIN=https://inbox.example.com
